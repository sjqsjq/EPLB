# Large raw tensors stay local and are hash-indexed; compact E1 timing JSON is tracked.
inputs/*.pt
inputs/*.pth
inputs/*.safetensors
inputs/**/*.pt
inputs/**/*.pth
inputs/**/*.safetensors
results/raw/**
!results/raw/.gitkeep
!results/raw/e1_pilot.json

# Traces and profiler databases can exceed GitHub's object limit.
traces/*.nsys-rep
traces/*.qdrep
traces/*.sqlite
traces/*.json
traces/*.json.gz
traces/*.tar*

logs/*.log
logs/*.out
logs/*.err
__pycache__/
*.pyc
core
core.*
core-*
